# Environment files (Requirement: DB credentials must not be committed)
.env
.env.backup
.env.production
.env.local

# Dependency directories
backend/vendor/
frontend/node_modules/

# Build artifacts
frontend/dist/

# SQLite databases
backend/database/*.sqlite
